{
	"name": "galatanovidiu/abilities-rest-adapter",
	"description": "Defines Abilities API abilities by reusing existing REST API routes (schema, validation, permission, handler) via rest_do_request().",
	"license": "MIT",
	"type": "wordpress-plugin",
	"keywords": [
		"wordpress",
		"abilities-api",
		"rest-api",
		"ai"
	],
	"homepage": "https://github.com/galatanovidiu/abilities-rest-adapter",
	"authors": [
		{
			"name": "Ovidiu Galatan",
			"homepage": "https://github.com/galatanovidiu"
		}
	],
	"support": {
		"issues": "https://github.com/galatanovidiu/abilities-rest-adapter/issues",
		"source": "https://github.com/galatanovidiu/abilities-rest-adapter"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"platform": {
			"php": "7.4"
		},
		"sort-packages": true,
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"autoload": {
		"classmap": [
			"includes/"
		],
		"files": [
			"includes/api.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"GalatanOvidiu\\AbilitiesRestAdapter\\Tests\\": "tests/phpunit/"
		}
	},
	"require": {
		"php": "^7.4 || ^8.0"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan": "^2.1.22",
		"phpstan/phpstan-deprecation-rules": "^2.0.3",
		"phpunit/phpunit": "^9.6",
		"slevomat/coding-standard": "^8.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"format": "phpcbf",
		"lint": "phpcs",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit"
	},
	"scripts-descriptions": {
		"format": "Automatically fix coding standards issues",
		"lint": "Check coding standards compliance",
		"phpstan": "Run static analysis with PHPStan",
		"test": "Run PHPUnit tests"
	}
}